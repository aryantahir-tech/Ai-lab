        "# --- Simple function ---\n",
        "def say_hello():\n",
        "    print(\"Hello, World!\")\n",
        "\n",
        "say_hello()\n",
        "\n",
        "# --- Function with a parameter ---\n",
        "def greet(name):\n",
        "    print(\"Hello,\", name)\n",
        "\n",
        "greet(\"Ali\")\n",
        "greet(\"Sara\")\n",
        "\n",
        "# --- Function with return value ---\n",
        "def add(a, b):\n",
        "    return a + b\n",
        "\n",
        "result = add(5, 3)\n",
        "print(\"5 + 3 =\", result)\n",
        "\n",
        "# --- Function with default parameter ---\n",
        "def welcome(name=\"Guest\"):\n",
        "    print(\"Welcome,\", name)\n",
        "\n",
        "welcome()\n",
        "welcome(\"Ahmed\")\n",
        "\n",
        "# --- Even or odd ---\n",
        "def check_even_odd(num):\n",
        "    if num % 2 == 0:\n",
        "        return \"Even\"\n",
        "    else:\n",
        "        return \"Odd\"\n",
        "\n",
        "print(\"4 is\", check_even_odd(4))\n",
        "print(\"7 is\", check_even_odd(7))\n",
        "\n",
        "# --- Simple calculator functions ---\n",
        "def subtract(a, b):\n",
        "    return a - b\n",
        "\n",
        "def multiply(a, b):\n",
        "    return a * b\n",
        "\n",
        "def divide(a, b):\n",
        "    if b == 0:\n",
        "        return \"Cannot divide by zero\"\n",
        "    return a / b\n",
        "\n",
        "print(\"10 - 4 =\", subtract(10, 4))\n",
        "print(\"10 * 4 =\", multiply(10, 4))\n",
        "print(\"10 / 4 =\", divide(10, 4))\n",
        "print(\"10 / 0 =\", divide(10, 0))\n",
        "\n",
        "# --- Function using a loop ---\n",
        "def factorial(n):\n",
        "    result = 1\n",
        "    for i in range(1, n + 1):\n",
        "        result *= i\n",
        "    return result\n",
        "\n",
        "print(\"Factorial of 5 =\", factorial(5))\n",
        "\n",
        "# --- Function returning multiple values ---\n",
        "def min_max(numbers):\n",
        "    return min(numbers), max(numbers)\n",
