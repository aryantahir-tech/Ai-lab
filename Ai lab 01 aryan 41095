        "\n",
        "\n",
        "# --- for loop with range ---\n",
        "print(\"--- for loop: 1 to 5 ---\")\n",
        "for i in range(1, 6):\n",
        "    print(i)\n",
        "\n",
        "# --- range with step ---\n",
        "print(\"--- Even numbers 2 to 10 ---\")\n",
        "for i in range(2, 11, 2):\n",
        "    print(i)\n",
        "\n",
        "# --- Loop through a list ---\n",
        "print(\"--- Loop through list ---\")\n",
        "fruits = [\"apple\", \"banana\", \"cherry\"]\n",
        "for fruit in fruits:\n",
        "    print(fruit)\n",
        "\n",
        "# --- Loop through a string ---\n",
        "print(\"--- Loop through string ---\")\n",
        "for letter in \"Python\":\n",
        "    print(letter)\n",
        "\n",
        "# --- while loop ---\n",
        "print(\"--- while loop ---\")\n",
        "count = 1\n",
        "while count <= 5:\n",
        "    print(\"Count:\", count)\n",
        "    count += 1\n",
        "\n",
        "# --- break ---\n",
        "print(\"--- break ---\")\n",
        "for i in range(1, 10):\n",
        "    if i == 5:\n",
        "        break\n",
        "    print(i)\n",
        "\n",
        "# --- continue ---\n",
        "print(\"--- continue (skip 3) ---\")\n",
        "for i in range(1, 6):\n",
        "    if i == 3:\n",
        "        continue\n",
        "    print(i)\n",
        "\n",
        "# --- Sum of numbers 1 to 10 ---\n",
        "total = 0\n",
        "for i in range(1, 11):\n",
        "    total += i\n",
        "print(\"Sum 1 to 10 =\", total)\n",
        "\n",
        "# --- Multiplication table ---\n",
